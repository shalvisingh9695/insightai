# MONGO_URI: MongoDB Atlas connection string (encode special password chars like @ -> %40)
# Example: mongodb+srv://username:password%40123@cluster0.abcde.mongodb.net/resume_ai?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://<username>:<password>@<cluster-url>/resume_ai?retryWrites=true&w=majority"
MONGODB_URI="mongodb://localhost:27017/resumeai"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# VITE_API_URL: Base URL for frontend API client
VITE_API_URL="http://localhost:3000/api"

